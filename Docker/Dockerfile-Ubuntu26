FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=bosss
ARG UID=1000
ARG GID=1000

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
	&& echo "path-include=/usr/share/doc/libprrte-dev/help-*" >> /etc/dpkg/dpkg.cfg.d/excludes \
	&& apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		gnupg \
		libgssapi-krb5-2 \
		libicu-dev \
		libopenmpi-dev \
		libprrte-dev \
		libssl-dev \
		libstdc++6 \
		libpmix-bin \
		openmpi-bin \
		openmpi-common \
		octave \
		gnuplot \
		openssh-client \
		sudo \
		wget \
		nano \
		zlib1g \
	&& MULTIARCH="$(dpkg -L libprrte3 2>/dev/null | sed -n 's|^/usr/lib/\([^/]*\)/libprrte\.so.*|\1|p' | head -n1)" \
	&& [ -n "$MULTIARCH" ] || MULTIARCH="$(uname -m)-linux-gnu" \
	&& PRTE_HELP_DIR="/usr/lib/$MULTIARCH/prrte3/share/prte" \
	&& if [ ! -f "$PRTE_HELP_DIR/help-prun.txt" ]; then \
		if ! ls /usr/share/doc/libprrte-dev/help-*.txt* >/dev/null 2>&1; then \
			echo "ERROR: PRRTE help files not found in libprrte-dev; check dpkg path-include and LP#2155666" >&2; \
			exit 1; \
		fi; \
		mkdir -p "$PRTE_HELP_DIR" \
		&& cp /usr/share/doc/libprrte-dev/help-*.txt* "$PRTE_HELP_DIR/" \
		&& gzip -df "$PRTE_HELP_DIR"/*.gz ; \
	fi \
	&& rm -rf /var/lib/apt/lists/*

RUN mpiexec --version

# Install .NET SDK 8 and 10 without relying on Ubuntu-specific packages.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
	&& chmod +x /tmp/dotnet-install.sh \
	&& /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet --no-path \
	&& /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet --no-path \
	&& ln -sfn /usr/share/dotnet/dotnet /usr/bin/dotnet \
	&& rm /tmp/dotnet-install.sh

ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH=/usr/share/dotnet:${PATH}

# Install Node.js (for CLI tools) from NodeSource.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends nodejs \
	&& rm -rf /var/lib/apt/lists/*

# Python: `pip` and `pipx` available globally.
# The Jupyter stack lives in one shared pipx venv (apps exposed in /usr/local/bin),
# so that `jupyter`, `jupyter-nbconvert`, `papermill` and the python3 kernel (ipykernel) see each other.
# BoSSSpad --JupyterBatch (e.g. TutorialTests) requires `papermill` and `jupyter nbconvert`.
ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
ENV PIPX_MAN_DIR=/usr/local/share/man
RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		python3 \
		python3-dev \
		python3-pip \
		python3-venv \
		pipx \
	&& rm -rf /var/lib/apt/lists/* \
	&& pipx install --include-deps notebook \
	&& pipx inject notebook nbconvert jupyter_core jupyter_client ipykernel \
	&& pipx inject --include-apps notebook papermill \
	&& pip --version \
	&& pipx --version \
	&& jupyter --version \
	&& papermill --version

# Try to install Claude and Codex CLIs.
# Build does not fail if upstream package names or availability change.
RUN npm install -g @anthropic-ai/claude-code || true
RUN npm install -g @openai/codex || true

# Non-root user by default (recommended for OpenMPI usage and safer dev workflows).
# Base images may already contain the requested IDs (e.g. ubuntu at 1000:1000).
# Reuse the group and rename/move an existing user rather than duplicating IDs.
RUN test "${UID}" -ne 0 \
	&& if ! getent group "${GID}" > /dev/null; then \
		groupadd --gid "${GID}" "${USERNAME}"; \
	fi \
	&& if getent passwd "${UID}" > /dev/null; then \
		existing_user="$(getent passwd "${UID}" | cut -d: -f1)"; \
		if [ "$existing_user" != "${USERNAME}" ]; then \
			usermod --login "${USERNAME}" "$existing_user" || exit 1; \
		fi; \
		usermod --home "/home/${USERNAME}" --move-home \
			--gid "${GID}" --shell /bin/bash "${USERNAME}"; \
	else \
		useradd --uid "${UID}" --gid "${GID}" -m -s /bin/bash "${USERNAME}"; \
	fi \
	&& usermod -aG sudo "${USERNAME}" \
	&& echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
	&& chmod 0440 /etc/sudoers.d/${USERNAME}

COPY public/Docker/MatlabConnectorConfig.json /home/${USERNAME}/.BoSSS/etc/MatlabConnectorConfig.json

RUN chown -R ${USERNAME}:${GID} /home/${USERNAME}/.BoSSS/

COPY public/Docker/config-ubuntu26.toml /home/${USERNAME}/.codex/config.toml

RUN chown -R ${USERNAME}:${GID} /home/${USERNAME}/.codex


COPY public/Docker/settings.json /home/${USERNAME}/.claude/settings.json

RUN chown -R ${USERNAME}:${GID} /home/${USERNAME}/.claude


# Runtime location for full BoSSS host install copied from host-mounted folder.
RUN mkdir -p /home/${USERNAME}/BoSSS-Install \
	&& chown -R ${USERNAME}:${GID} /home/${USERNAME}/BoSSS-Install

# Copy scripts/configuration explicitly: legacy Docker builders can produce empty heredocs.
COPY public/Docker/bosss-entrypoint.sh /usr/local/bin/bosss-entrypoint.sh

RUN chmod +x /usr/local/bin/bosss-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/bosss-entrypoint.sh

ENV BOSSS_INSTALL=/home/${USERNAME}/BoSSS-Install
ENV LD_LIBRARY_PATH=/home/${USERNAME}/BoSSS-Install/bin/native/linux/amd64-openmpi

# .NET Interactive (C#, F#, PowerShell Jupyter kernels), installed as global tool for the non-root user.
ENV PATH=/home/${USERNAME}/.dotnet/tools:${PATH}
USER ${USERNAME}
RUN dotnet tool install --global Microsoft.dotnet-interactive \
	&& dotnet interactive jupyter install \
	&& jupyter kernelspec list

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/bosss-entrypoint.sh"]
CMD ["bash"]
