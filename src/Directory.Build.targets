<Project>
  <!-- imported after the project files, so that it also applies to projects which set NoWarn without $(NoWarn) -->
  <PropertyGroup>
    <!-- CS8981: lower-case type names (e.g. kcycle, cu, cl, vectype; public APIs, kept) -
         reported since the move from netstandard (C# 7.3) to net10.0 (owner decision 2026-10-02) -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
</Project>
